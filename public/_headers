# Cloudflare Pages header rules (ignored by any other host). Hashed build output
# is immutable; the document and the unhashed font are revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=604800
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
